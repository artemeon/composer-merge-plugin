{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "http://github.com/artemeon/composer-merge-plugin/modulesrc.schema.json#",

    "type": "object",
    "properties": {
        "modules": {
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^(?:module)?_\\w+$"
            }
        }
    },
    "required": ["modules"]
}
